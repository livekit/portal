# Copy to .env and fill in for local testing.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room shared by every script.
LIVEKIT_ROOM=portal-demo

# Optional overrides
PORTAL_FPS=30
PORTAL_FRAME_WIDTH=320
PORTAL_FRAME_HEIGHT=240
PORTAL_DURATION_SECONDS=30
PORTAL_TAKE_SECONDS=5
PORTAL_RECORDING_DIR=data/sessions
