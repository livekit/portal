# Copy to .env and fill in for local testing.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room shared by both scripts.
LIVEKIT_ROOM=portal-benchmark

# Optional overrides. Robot and operator must agree on FPS and codec.
PORTAL_FPS=30
PORTAL_CODEC=h264
PORTAL_FRAME_WIDTH=640
PORTAL_FRAME_HEIGHT=480
PORTAL_WARMUP_SECONDS=3
PORTAL_DURATION_SECONDS=30
